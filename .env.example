# --- Core (required) ---------------------------------------------------------
# PostgreSQL connection string. With `npm run db:up` (Docker) the default works.
DATABASE_URL=postgresql://spender:spender@localhost:5432/spender
# Direct connection (used by Prisma migrate when DATABASE_URL goes through a pooler).
DIRECT_URL=postgresql://spender:spender@localhost:5432/spender
# Secret for Auth.js session signing. Generate with: openssl rand -hex 32
AUTH_SECRET=
# NextAuth also reads NEXTAUTH_SECRET (use the same value as AUTH_SECRET in production).
NEXTAUTH_SECRET=
# Required in production (Vercel): full public URL, e.g. https://spender-chi-one.vercel.app
NEXTAUTH_URL=http://localhost:3000
# Public URL of the app.
APP_URL=http://localhost:3000
# 32-byte key (hex, 64 chars) for AES-256-GCM app-level encryption of private payloads.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Cache / queue (optional, falls back to in-memory) ------------------------
REDIS_URL=

# --- Stripe (optional, mock billing used when missing) ------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# --- Email (optional, console mock used when missing) -------------------------
RESEND_API_KEY=
EMAIL_FROM=Spender <noreply@spender.local>

# --- BankID OIDC (optional placeholder) ---------------------------------------
BANKID_CLIENT_ID=
BANKID_CLIENT_SECRET=
BANKID_ISSUER_URL=

# --- Vipps MobilePay (optional placeholder) ------------------------------------
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=

# --- Brønnøysundregistrene (open data, no key needed) --------------------------
BRREG_API_BASE_URL=https://data.brreg.no/enhetsregisteret/api

# --- Object storage (optional, local disk used when missing) -------------------
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- Analytics / monitoring (optional, console mock used when missing) ---------
POSTHOG_KEY=
POSTHOG_HOST=
SENTRY_DSN=

# --- Misc ----------------------------------------------------------------------
ADMIN_EMAIL=admin@spender.local

# --- Feature flags ---------------------------------------------------------------
FEATURE_MOCK_BILLING=true
FEATURE_MOCK_EMAIL=true
FEATURE_BANKID=false
FEATURE_VIPPS=false
FEATURE_STRIPE=false

# --- Retention overrides (days, optional) --------------------------------------
# RETENTION_DRAFT_DAYS=30
# RETENTION_ACTIVE_REQUEST_DAYS=30
# RETENTION_CLOSED_REQUEST_DAYS=180
